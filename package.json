{
  "name": "testersguild.github.io",
  "version": "1.0.0",
  "description": "Null and Void QA Course - Main Website",
  "private": true,
  "scripts": {
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:verbose": "jest --coverage --verbose",
    "start": "python -m http.server 8000",
    "test:e2e:smoke": "npx playwright test tests/e2e --project=chromium",
    "test:e2e": "npx playwright test",
    "validate:tracks": "node scripts/validate-tracks.js",
    "validate:lessons": "node scripts/validate-lessons.js",
    "validate:i18n": "node scripts/sync-translations.js",
    "validate:all": "npm run lint && npm run validate:tracks && npm run validate:lessons && npm run validate:i18n && npm test",
    "validate:links": "node scripts/verify-links.js",
    "lint:js": "eslint js/ --ext .js",
    "lint:css": "stylelint css/**/*.css",
    "lint:html": "htmlhint *.html",
    "lint": "npm run lint:js && npm run lint:css && npm run lint:html",
    "format": "prettier --write \"**/*.{js,json,css,html,md}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^29.16.0",
    "htmlhint": "^1.1.4",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.9.6",
    "stylelint": "^16.3.0",
    "stylelint-config-standard": "^36.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "playwright": "^1.62.1"
  }
}
